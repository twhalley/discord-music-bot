# systemd *user* unit for the Discord music bot, running as a rootless podman
# container. Install to ~/.config/systemd/user/musicbot.service on the Oracle VM.
#
# Rootless by design: nothing here needs root — no privileged ports, no host
# mounts, and the image already runs as an unprivileged user internally. So the
# deploy user needs no sudo rights at all, and a compromised SSH key is not a
# root credential on the host.
#
# Reads two 0600 files that the GitHub deploy workflow writes, both owned by the
# deploy user rather than root:
#   ~/.config/musicbot/image  ->  MUSICBOT_IMAGE=ghcr.io/OWNER/REPO:TAG
#   ~/.config/musicbot/env    ->  DISCORD_BOT_TOKEN=...
#
# Requires `loginctl enable-linger <user>` so the unit starts at boot without a
# login session. See deploy/README.md section 3.

[Unit]
Description=Discord music bot (YouTube/SoundCloud)
# Wants, not Requires: if the token provider is down the bot must still run.
# YouTube refuses a few videos, everything else keeps working.
Wants=network-online.target musicbot-pod.service musicbot-pot.service
After=network-online.target musicbot-pod.service musicbot-pot.service
# Give up only if it crash-loops hard (>5 times in 60s). These are [Unit]
# directives — systemd silently ignores them if placed in [Service].
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=%h/.config/musicbot/image
EnvironmentFile=%h/.config/musicbot/env

# Tag journal entries so `journalctl -t musicbot` works and lines are readable.
SyslogIdentifier=musicbot

# Clean up any prior container before starting.
ExecStartPre=-/usr/bin/podman rm -f musicbot
# On --log-driver=none: podman's default rootless driver is `journald`, so
# conmon writes every line to the journal *and* systemd captures the same line
# from podman's stdout -- storing each message twice. `none` disables conmon's
# copy; stdout still reaches systemd, so journalctl is unaffected. The cost is
# that `podman logs musicbot` returns nothing -- use journalctl instead.
# (`passthrough` would be cleaner but needs podman >= 4.0; 22.04 ships 3.4.4.)
ExecStart=/usr/bin/podman run \
    --rm \
    --name musicbot \
    --pod musicbot-pod \
    --log-driver=none \
    --read-only \
    --tmpfs /tmp:rw,size=64m,mode=1777,noexec,nosuid,nodev \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --pids-limit=256 \
    --memory=512m \
    --env-file=%h/.config/musicbot/env \
    --env=POT_PROVIDER_BASE_URL=http://127.0.0.1:4416 \
    ${MUSICBOT_IMAGE}
ExecStop=/usr/bin/podman stop --time 10 musicbot

Restart=always
RestartSec=5

[Install]
# User units install to default.target, not multi-user.target.
WantedBy=default.target
