# Copy to .env for local development (never commit .env).
# On the server, these are provided by /etc/musicbot.env instead.

# Required: your bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Optional: a guild (server) id for instant slash-command sync while developing.
# Leave blank in production to sync commands globally.
DEV_GUILD_ID=

# Optional: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: comma-separated guild (server) ids the bot is allowed to serve.
# Leave blank to allow any guild, which is the default. Setting it bounds the
# damage if an invite link leaks — the bot leaves anywhere not on the list,
# both on join and on startup, rather than quietly streaming for strangers.
# e.g. ALLOWED_GUILD_IDS=123456789012345678,987654321098765432
ALLOWED_GUILD_IDS=
