# Periodic health check for the VPN exit.
#
# Every 30 minutes rather than every few: the probe is a real YouTube
# extraction, and hammering it would itself look like automated traffic --
# which is the exact thing being worked around.

[Unit]
Description=Periodically check the music bot's VPN exit

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min
RandomizedDelaySec=5m
Persistent=true

[Install]
WantedBy=timers.target
