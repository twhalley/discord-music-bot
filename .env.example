# Copy to .env for local development (never commit .env).
# On the server, these are provided by /etc/musicbot.env instead.

# Required: your bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Optional: a guild (server) id for instant slash-command sync while developing.
# Leave blank in production to sync commands globally.
DEV_GUILD_ID=

# Optional: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
