#!/usr/bin/env bash
#
# Route ONLY the bot's traffic through a WireGuard tunnel, and rotate exits.
#
# Why not just `wg-quick up` a normal config?
# ------------------------------------------
# A stock WireGuard config sets AllowedIPs = 0.0.0.0/0 and takes over the
# default route. On this VM that breaks inbound SSH -- replies would leave via
# the tunnel while the request arrived on the public interface -- which locks
# you out and takes the GitHub deploy workflow with it.
#
# Instead the tunnel's routes go into a dedicated routing table, and a single
# `ip rule` sends only the bot service account's traffic there. Everything else
# -- SSH, the deploy, apt, cloud-init -- stays on the normal route.
#
# That works because the container runs ROOTLESS: its packets are emitted by
# slirp4netns running as the service account, so they carry that uid. The same
# property the egress firewall rules rely on.
#
# Usage:
#   musicbot-vpn list                 # available exits
#   musicbot-vpn up <exit>            # bring up, route the bot through it
#   musicbot-vpn down                 # tear down, bot returns to the host IP
#   musicbot-vpn status               # what is up, and the bot's apparent IP
#   musicbot-vpn rotate               # switch to the next exit in the list
#   musicbot-vpn check <video-id>...  # does YouTube serve these through it?
#   musicbot-vpn refresh-routes       # update which prefixes use the tunnel
#   musicbot-vpn health               # rotate away from a blocked exit, if needed
#
# Place provider configs at /etc/wireguard/src/<exit>.conf (root, 0600). They
# are never used directly: `up` derives a config with the routing overrides
# applied, so a provider's stock file can be dropped in unmodified.

set -euo pipefail

readonly BOT_USER="${MUSICBOT_USER:-musicbot}"
readonly VPN_TABLE="${MUSICBOT_VPN_TABLE:-51820}"
readonly RULE_PRIO="${MUSICBOT_VPN_RULE_PRIO:-1000}"
readonly SRC_DIR="/etc/wireguard/src"
readonly IFACE="mbvpn"
readonly DERIVED="/etc/wireguard/${IFACE}.conf"
readonly STATE="/var/lib/musicbot-vpn/current"
readonly SPLIT_FILE="/etc/wireguard/tunnel-prefixes.txt"
readonly SELF="/usr/local/sbin/musicbot-vpn"
# Google publishes the ranges that serve YouTube and its media CDN.
readonly GOOG_URL="https://www.gstatic.com/ipranges/goog.json"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "must run as root (use sudo)"; }

bot_uid() { id -u "$BOT_USER" 2>/dev/null || die "no such user: $BOT_USER"; }

list_exits() {
    [ -d "$SRC_DIR" ] || die "$SRC_DIR does not exist -- put provider .conf files there"
    find "$SRC_DIR" -maxdepth 1 -name '*.conf' -printf '%f\n' 2>/dev/null \
        | sed 's/\.conf$//' | sort
}

# Derive a config from the provider's, forcing the routing behaviour we need.
#
#   Table   = <n>   keeps wg-quick off the default route
#   PostUp  rule    sends only the bot uid to that table
#   DNS     dropped wg-quick would rewrite /etc/resolv.conf system-wide, and a
#                   provider DNS on a private address is refused by the egress
#                   firewall anyway. Name resolution keeps using the host
#                   resolver; only the connection itself is tunnelled.
write_derived_config() {
    local exit_name="$1" src="$SRC_DIR/$1.conf" uid
    [ -f "$src" ] || die "unknown exit '$exit_name' (try: musicbot-vpn list)"
    uid="$(bot_uid)"

    install -m 600 /dev/null "$DERIVED"

    # These MUST land inside [Interface]. Appending them to the end of the file
    # puts them under [Peer], where wg-quick does not strip them and `wg
    # setconf` rejects the file outright ("Line unrecognized: PostUp=...").
    # Table = off: wg-quick adds no routes at all. We populate the table
    # ourselves so it can hold *either* a default route (everything tunnelled)
    # or just the Google prefixes (split routing) -- see routes_up().
    awk -v self="$SELF" '
        /^[[:space:]]*(Table|DNS)[[:space:]]*=/ { next }        # we set these
        /^[[:space:]]*(PostUp|PostDown)[[:space:]]*=/ { next }  # avoid surprises
        { print }
        /^\[Interface\]/ {
            print "Table = off"
            print "PostUp = " self " _routes up %i"
            print "PostDown = " self " _routes down %i"
        }
    ' "$src" >> "$DERIVED"
}

# Populate the VPN routing table and install the uid rule.
#
# SPLIT MODE (a prefix file exists): only those prefixes get routes in the
# table. Anything else the bot sends finds no match there and falls through to
# the main table -- so Discord voice goes out the VM's own connection, direct
# and undetoured. This is why there is no default route here.
#
# FULL MODE (no prefix file): a default route, everything tunnelled. Kept as a
# fallback so a missing prefix file degrades to "working but slower voice"
# rather than "YouTube broken".
routes_up() {
    local iface="$1" uid; uid="$(bot_uid)"
    ip route flush table "$VPN_TABLE" 2>/dev/null || true

    if [ -s "$SPLIT_FILE" ]; then
        local n=0
        while read -r prefix; do
            case "$prefix" in ''|\#*) continue ;; esac
            ip route add "$prefix" dev "$iface" table "$VPN_TABLE" 2>/dev/null && n=$((n + 1))
        done < "$SPLIT_FILE"
        printf 'split routing: %d prefixes via tunnel, everything else direct\n' "$n"
    else
        ip route add default dev "$iface" table "$VPN_TABLE"
        echo "full tunnel: all bot traffic via VPN (no prefix file; run: musicbot-vpn refresh-routes)"
    fi

    ip rule add uidrange "${uid}-${uid}" lookup "$VPN_TABLE" priority "$RULE_PRIO" 2>/dev/null || true
}

routes_down() {
    local uid; uid="$(bot_uid)"
    ip rule del uidrange "${uid}-${uid}" lookup "$VPN_TABLE" priority "$RULE_PRIO" 2>/dev/null || true
    ip route flush table "$VPN_TABLE" 2>/dev/null || true
}

# Refresh the list of prefixes that should go through the tunnel.
cmd_refresh_routes() {
    need_root
    local tmp; tmp="$(mktemp)"
    if ! curl -fsS --max-time 30 "$GOOG_URL" -o "$tmp"; then
        rm -f "$tmp"; die "could not fetch $GOOG_URL"
    fi
    python3 - "$tmp" > "$SPLIT_FILE" <<'PYEOF'
import json, sys
data = json.load(open(sys.argv[1]))
print("# Google/YouTube IPv4 prefixes -- regenerate with: musicbot-vpn refresh-routes")
for entry in data.get("prefixes", []):
    p = entry.get("ipv4Prefix")
    if p:
        print(p)
PYEOF
    rm -f "$tmp"
    chmod 644 "$SPLIT_FILE"
    printf 'wrote %d prefixes to %s\n' "$(grep -vc '^#' "$SPLIT_FILE")" "$SPLIT_FILE"
    echo "run 'musicbot-vpn up <exit>' (or rotate) to apply"
}

apparent_ip_as_bot() {
    # What the internet sees for the bot's uid. Run as the service account so
    # the policy rule applies; a plain root curl would show the host IP.
    sudo -u "$BOT_USER" curl -s --max-time 15 https://api.ipify.org 2>/dev/null || echo "unavailable"
}

apparent_ip_as_host() {
    curl -s --max-time 15 https://api.ipify.org 2>/dev/null || echo "unavailable"
}

cmd_up() {
    need_root
    local exit_name="${1:-}"
    [ -n "$exit_name" ] || die "usage: musicbot-vpn up <exit>"
    cmd_down >/dev/null 2>&1 || true
    write_derived_config "$exit_name"
    wg-quick up "$IFACE"
    install -d -m 755 "$(dirname "$STATE")"
    printf '%s\n' "$exit_name" > "$STATE"
    printf 'up: %s\n' "$exit_name"
    printf 'bot sees:  %s\n' "$(apparent_ip_as_bot)"
    printf 'host sees: %s  (unchanged, SSH safe)\n' "$(apparent_ip_as_host)"
}

cmd_down() {
    need_root
    wg-quick down "$IFACE" 2>/dev/null || true
    rm -f "$DERIVED" "$STATE"
    echo "down: bot traffic back on the host address"
}

cmd_status() {
    local current="none" uid; uid="$(bot_uid)"
    [ -f "$STATE" ] && current="$(cat "$STATE")"
    printf 'exit:      %s\n' "$current"
    printf 'interface: %s\n' "$(ip link show "$IFACE" >/dev/null 2>&1 && echo up || echo down)"
    printf 'routes:    %s in table %s\n' "$(ip route show table "$VPN_TABLE" 2>/dev/null | wc -l)" "$VPN_TABLE"
    printf 'mode:      %s\n' \
        "$(ip route show table "$VPN_TABLE" 2>/dev/null | grep -q '^default' && echo 'full tunnel' || echo 'split (Google via tunnel, rest direct)')"

    # Under split routing the bot's apparent IP is the HOST's for anything
    # non-Google, which looks like failure but is the point. Report which
    # interface each destination actually selects instead -- that is the
    # question, and it does not depend on an external echo service.
    local yt dc
    yt="$(getent ahostsv4 www.youtube.com 2>/dev/null | head -1 | cut -d' ' -f1)"
    dc="$(getent ahostsv4 discord.com 2>/dev/null | head -1 | cut -d' ' -f1)"
    [ -n "$yt" ] && printf 'youtube:   via %s\n' \
        "$(ip route get "$yt" uid "$uid" 2>/dev/null | head -1 | grep -o 'dev [a-z0-9]*' | cut -d' ' -f2)"
    [ -n "$dc" ] && printf 'discord:   via %s  (should NOT be %s)\n' \
        "$(ip route get "$dc" uid "$uid" 2>/dev/null | head -1 | grep -o 'dev [a-z0-9]*' | cut -d' ' -f2)" "$IFACE"
    printf 'host sees: %s\n' "$(apparent_ip_as_host)"
}

cmd_rotate() {
    need_root
    local -a exits; mapfile -t exits < <(list_exits)
    [ "${#exits[@]}" -gt 0 ] || die "no configs in $SRC_DIR"
    local current="" next="${exits[0]}"
    [ -f "$STATE" ] && current="$(cat "$STATE")"
    for i in "${!exits[@]}"; do
        if [ "${exits[$i]}" = "$current" ]; then
            next="${exits[$(( (i + 1) % ${#exits[@]} ))]}"
            break
        fi
    done
    printf 'rotating: %s -> %s\n' "${current:-none}" "$next"
    cmd_up "$next"
}

# Does YouTube actually serve audio through the current exit? This is the only
# question that matters -- a tunnel that comes up but is still blocked is worth
# nothing here.
# Probe one video through the current exit. 0 = playable, non-zero otherwise.
probe_video() {
    local id="$1"
    # cd / first: sudo drops privileges before chdir, and root's cwd is
    # typically /home/ubuntu which the service account cannot enter -- sudo
    # then fails with "cannot chdir" and every probe reports a false negative
    # before podman is ever reached.
    (cd / && sudo -u "$BOT_USER" env XDG_RUNTIME_DIR="/run/user/$(bot_uid)" \
        podman exec musicbot python -c "
import sys, io, contextlib
from yt_dlp import YoutubeDL
o={'format':'bestaudio/best','noplaylist':True,'quiet':True,'no_warnings':True,
   'skip_download':True,'cachedir':False,'socket_timeout':25}
buf=io.StringIO()
try:
    with contextlib.redirect_stderr(buf):
        with YoutubeDL(o) as y:
            i=y.extract_info('https://www.youtube.com/watch?v=${id}',download=False)
    sys.exit(0 if (i or {}).get('url') else 2)
except Exception as e:
    sys.exit(3 if 'not a bot' in str(e) else 4)
" >/dev/null 2>&1)
}

cmd_check() {
    local ids=("$@")
    [ "${#ids[@]}" -gt 0 ] || ids=(dQw4w9WgXcQ)
    printf 'checking %d video(s) as %s...\n' "${#ids[@]}" "$BOT_USER"
    for id in "${ids[@]}"; do
        if probe_video "$id"; then
            printf '  %-14s OK\n' "$id"
        else
            case $? in
                2) printf '  %-14s no formats\n' "$id" ;;
                3) printf '  %-14s BLOCKED (bot check)\n' "$id" ;;
                *) printf '  %-14s failed\n' "$id" ;;
            esac
        fi
    done
}

# Self-heal: if YouTube is refusing the current exit, rotate until one works.
#
# Exists because a flagged exit is otherwise silent -- playback simply starts
# failing and stays failed until a human notices and investigates. With 36
# exits configured, recovering is mechanical, so it should not need a human.
#
# Deliberately conservative: it only rotates when the current exit ACTUALLY
# fails, never on a schedule. Rotating a working exit risks landing on a
# blocked one, which would turn a health check into an outage.
cmd_health() {
    need_root
    local probe="${MUSICBOT_HEALTH_VIDEO:-dQw4w9WgXcQ}"
    local max="${MUSICBOT_HEALTH_MAX_ROTATIONS:-5}"

    if probe_video "$probe"; then
        echo "healthy: $(cat "$STATE" 2>/dev/null || echo 'no tunnel')"
        return 0
    fi

    logger -t musicbot-vpn "exit $(cat "$STATE" 2>/dev/null) failing; rotating" 2>/dev/null || true
    echo "current exit is failing; rotating..."

    local i
    for (( i = 1; i <= max; i++ )); do
        cmd_rotate >/dev/null 2>&1 || true
        sleep 5
        if probe_video "$probe"; then
            local now; now="$(cat "$STATE" 2>/dev/null)"
            logger -t musicbot-vpn "recovered on exit $now" 2>/dev/null || true
            echo "recovered on: $now"
            return 0
        fi
        echo "  $(cat "$STATE" 2>/dev/null) also failing"
    done

    logger -t musicbot-vpn "no working exit after $max rotations" 2>/dev/null || true
    echo "no working exit found after $max rotations"
    return 1
}

case "${1:-}" in
    list)   list_exits ;;
    up)     shift; cmd_up "$@" ;;
    down)   cmd_down ;;
    status) cmd_status ;;
    rotate) cmd_rotate ;;
    check)  shift; cmd_check "$@" ;;
    refresh-routes) cmd_refresh_routes ;;
    health) cmd_health ;;
    _routes) need_root; case "${2:-}" in up) routes_up "${3:?}" ;; down) routes_down ;; esac ;;
    *)      sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//' ; exit 1 ;;
esac
