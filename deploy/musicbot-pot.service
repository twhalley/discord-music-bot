# Proof-of-origin token provider for yt-dlp (bgutil-ytdlp-pot-provider).
#
# YouTube refuses some videos from datacenter IPs with "Sign in to confirm
# you're not a bot". Satisfying that check needs a PO token, produced by running
# YouTube's BotGuard challenge in a JS runtime. yt-dlp cannot do that itself, so
# this service does it and the yt-dlp plugin in the bot image asks it on demand.
#
# It runs in its own container, not inside the bot, deliberately: the whole
# purpose of this image is executing a third party's obfuscated JS challenge,
# and it has no business sharing a process space with the Discord token.
#
# It holds no secrets, binds only inside the pod, and is covered by the same
# host egress rules as the bot -- those are scoped to the deploy account's uid,
# and this runs under the same account, so it cannot reach the metadata service
# or the VPC either.
#
# Install to ~/.config/systemd/user/musicbot-pot.service on the deploy account.
# The image is pinned by digest in ~/.config/musicbot/pot-image; the digest must
# be bumped by hand, since Dependabot cannot see image references in unit files.

[Unit]
Description=yt-dlp PO token provider (BotGuard)
Wants=musicbot-pod.service network-online.target
After=musicbot-pod.service network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=%h/.config/musicbot/pot-image
SyslogIdentifier=musicbot-pot

ExecStartPre=-/usr/bin/podman rm -f musicbot-pot
# Same hardening as the bot: verified read-only with all capabilities dropped.
ExecStart=/usr/bin/podman run \
    --rm \
    --name musicbot-pot \
    --pod musicbot \
    --read-only \
    --tmpfs /tmp:rw,size=64m,mode=1777,noexec,nosuid,nodev \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --pids-limit=128 \
    --memory=384m \
    --log-driver=none \
    ${MUSICBOT_POT_IMAGE}
ExecStop=/usr/bin/podman stop --time 10 musicbot-pot

Restart=always
RestartSec=5

[Install]
WantedBy=default.target
